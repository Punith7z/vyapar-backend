+def parse_with_gemini(text: str, instruction: str) -> dict:
+    if not api_key:
+        raise Exception("AUTH_ERROR: GEMINI_API_KEY is not set.")
+    if FORCE_GEMINI_FAILURE:
+        raise Exception("RATE_LIMITED: Simulated Gemini failure")
+    client = genai.Client()
+    response = client.models.generate_content(
+        model=GEMINI_MODEL,
+        contents=text,
+        config=types.GenerateContentConfig(
+            system_instruction=instruction,
+            temperature=0.0,
+            response_mime_type="application/json"
+        ),
+    )
+    return json.loads(response.text)
+
+def parse_with_groq(text: str, instruction: str) -> dict:
+    if not groq_api_key:
+        raise Exception("AUTH_ERROR: GROQ_API_KEY is not set.")
+    client = groq.Groq(api_key=groq_api_key)
+    completion = client.chat.completions.create(
+        model=GROQ_PARSER_MODEL,
+        messages=[
+            {"role": "system", "content": instruction},
+            {"role": "user", "content": text}
+        ],
+        temperature=0.0,
+        response_format={"type": "json_object"}
+    )
+    return json.loads(completion.choices[0].message.content)
+
